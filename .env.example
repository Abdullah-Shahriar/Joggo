APP_NAME=ClinicShield
ENV=dev
DATABASE_URL=postgresql+psycopg://clinicshield:clinicshield@localhost:5432/clinicshield
JWT_SECRET=change-me-32-chars-minimum-secret-key
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=<set to a current Gemini Flash-class model id from Google AI Studio docs>
GROQ_API_KEY=
GROQ_MODEL=<set to a current Groq-hosted instruct model id from Groq docs>
LLM_PROVIDER_ORDER=gemini,groq
SPACY_MODEL=en_core_web_sm
OCR_LANGS=eng
DATE_ORDER=DMY
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=30
VAULT_IDLE_MINUTES=30
VAULT_ABSOLUTE_HOURS=8
VAULT_MAX_MB=300
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
AUDITOR_SEED_EMAIL=
AUDITOR_SEED_PASSWORD=
DOCTOR_SEED_EMAIL=
DOCTOR_SEED_PASSWORD=
